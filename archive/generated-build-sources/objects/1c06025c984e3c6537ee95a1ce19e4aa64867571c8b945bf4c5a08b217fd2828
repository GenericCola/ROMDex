import test from 'node:test';import assert from 'node:assert/strict';
import '../content/classic-model.js';import {document as original} from './cloud-merge-fixture.mjs';import {previewLegacyMigration} from '../content/migration.mjs';import {projectNPCDex} from '../content/projection.mjs';import {buildEdit} from '../content/edits.mjs';import {seal} from '../content/contracts.mjs';import {editorSetup} from './content-editor-fixture.mjs';
const C=globalThis.romdexClassicModel;
function setup(){const data=original();data.preferences={gender:'male'};data.changePlans={};data.annotations={};const m=previewLegacyMigration({bytes:Buffer.from(JSON.stringify(data)),workspace:'fixture:workspace',regions:{town:'Johto'},createdAt:'2026-10-18T13:20:00.000Z',sourceHead:'classic-source'});let domain=m.domain,n=0;const context=()=>({records:domain.records.filter(r=>!r.current.payload.definitions?.migration),plans:domain.plans,reviews:domain.reviews}),view=()=>C.decorate(projectNPCDex(domain,{revision:73,gender:'male',assetBytes:h=>m.assetBytes.get(h)}),context());return {get domain(){return domain;},context,view,apply(spec){const command=C.command(context(),spec),edit=buildEdit(domain,command,{workspace:'fixture:workspace',head:domain.publications?.at(-1)?.digest||'fixture:initial',operationId:'fixture:classic-'+(++n),createdAt:'2026-10-18T13:20:00.000Z'});domain=edit.preview;return edit;}};}
const prompt={townId:'town',type:'prompt',id:'prompt:point:entry:block:0',pointId:'point',blockIds:['block'],gender:'male'};
const review=(after={})=>({type:'review',key:prompt.id,context:{townId:'town',pointId:'point',blockId:'block',scope:'prompt',passageKeys:['entry:block:0'],gender:'male'},after:{flag:false,note:'',testStatus:'unreviewed',...after}});
test('Original inline note and critical flag retain exact whitespace and survive database projection',()=>{const s=setup(),spec=review({flag:true,critical:true,note:'Two words\nwith a trailing space '});s.apply(spec);const d=s.view(),a=d.annotations[spec.key];assert.equal(a.note,spec.after.note);assert.equal(a.flag,true);assert.equal(a.critical,true);assert.equal(a.scope,'prompt');assert(d.contentPreview.feedbackKeys[spec.key].reviewId);assert.deepEqual(s.domain.records.map(r=>r.current),setup().domain.records.map(r=>r.current));});
test('Standard flag and clear flag preserve the same note identity and its text',()=>{const s=setup(),a=review({flag:true,note:'Keep my note '});s.apply(a);const v=s.view();s.apply({...a,identity:v.contentPreview.feedbackKeys[a.key].reviewId,after:{...a.after,flag:false}});assert.equal(C.heads(s.domain.reviews).length,1);assert.equal(s.domain.reviews.length,2);assert.equal(s.view().annotations[a.key].flag,false);assert.equal(s.view().annotations[a.key].note,'Keep my note ');});
test('Original status toggle-off appends a superseded revision without deleting history',()=>{const s=setup(),key='town|prompt|'+prompt.id,p={id:'local-plan',target:prompt,intent:'UPDATE',instructions:'Make this change ',proposedDialogue:''};s.apply({type:'plan',key,target:prompt,after:p});let v=s.view(),saved=v.changePlans[key];assert.equal(saved.intent,'UPDATE');s.apply({type:'plan',key,target:prompt,before:saved,after:undefined,identity:v.contentPreview.feedbackKeys[key].planId});v=s.view();assert.equal(v.changePlans[key],undefined);assert.equal(v.promptStatusUnset[key],true);assert.equal(s.domain.plans.length,2);assert.equal(C.heads(s.domain.plans)[0].workflow,'superseded');s.apply({type:'plan',key,target:prompt,after:{...p,intent:'FINAL'},identity:v.contentPreview.feedbackKeys[key].planId});assert.equal(s.view().changePlans[key].intent,'FINAL');assert.equal(s.domain.plans.length,3);});
test('Changing an inherited decision creates a prompt decision, never modifies current dialogue',()=>{const s=setup(),before=JSON.stringify(s.domain.records),key='town|prompt|'+prompt.id;s.apply({type:'plan',key,target:prompt,after:{target:prompt,intent:'REMOVE',instructions:'Remove this prompt',proposedDialogue:''}});assert.equal(JSON.stringify(s.domain.records),before);assert.equal(s.view().changePlans[key].intent,'REMOVE');});
test('Selected-line notes keep a distinct scope and identity from whole-prompt notes',()=>{const s=setup(),whole=review({note:'Whole turn'});s.apply(whole);const line={...review({note:'Only this passage'}),key:'entry:block:0',context:{...whole.context,scope:'passage'}};s.apply(line);const v=s.view();assert.equal(v.annotations[whole.key].note,'Whole turn');assert.equal(v.annotations[line.key].note,'Only this passage');assert.equal(C.heads(s.domain.reviews).length,2);});
test('Tester status toggles preserve the original review target and require explicit verification',()=>{const s=setup(),spec=review({testStatus:'verified'});s.apply({...spec,testingChanged:true});let v=s.view();assert.equal(v.annotations[spec.key].testStatus,'verified');s.apply({...spec,identity:v.contentPreview.feedbackKeys[spec.key].reviewId,after:{...spec.after,testStatus:'unreviewed'},testingChanged:true});assert.equal(s.view().annotations[spec.key].testStatus,'unreviewed');});
test('Ambiguous or missing content mapping cannot silently save against another character',()=>{const s=setup(),r=s.context().records.find(r=>r.current.payload.points),duplicate={...r,recordId:'fixture:ambiguous'};assert.throws(()=>C.resolve([...s.context().records,duplicate],review()),/Target Needs Review/);assert.throws(()=>C.resolve(s.context().records,{...review(),context:{townId:'wrong',pointId:'point'}}),/Target Needs Review/);});
test('Competing review heads require explicit conflict review',()=>{const s=setup(),spec=review({note:'First'});s.apply(spec);const old=s.domain.reviews[0],fork=seal({...old,operationId:'fixture:competing',note:'Different',parents:[]});assert.throws(()=>C.command({...s.context(),reviews:[old,fork]},{...spec,identity:old.reviewId}),/Conflicting Feedback/);});
test('Independent remote note changes survive a local flag-only edit',()=>{const s=setup(),spec=review({note:'Remote note',flag:false});s.apply(spec);const prior=s.domain.reviews[0],before={note:'',flag:false,testStatus:'unreviewed'};s.apply({type:'review',key:spec.key,identity:prior.reviewId,context:spec.context,before,after:{...before,flag:true}});assert.equal(s.view().annotations[spec.key].note,'Remote note');assert.equal(s.view().annotations[spec.key].flag,true);});
test('Conflicting remote and local edits to the same note remain for review',()=>{const s=setup(),spec=review({note:'Remote note'});s.apply(spec);assert.throws(()=>s.apply({...spec,identity:s.domain.reviews[0].reviewId,before:{note:'Before',flag:false},after:{note:'Local note',flag:false}}),/Changed on Another Computer/);assert.equal(s.domain.reviews.length,1);});
test('Current content changing during inline editing requires review rather than rebasing silently',()=>{const s=setup(),spec=review({note:'Typed earlier'});assert.throws(()=>C.command(s.context(),{...spec,recordRevision:'an-older-content-revision'}),/Content Changed While/);});
test('Migrated feedback updates retain its immutable prompt scope and original baseline',()=>{const s=setup(),spec=review({note:'Before'});s.apply(spec);const prior=s.domain.reviews[0];s.apply({...spec,identity:prior.reviewId,context:{...spec.context,gender:'female'},after:{...spec.after,note:'After '}});const head=C.heads(s.domain.reviews)[0];assert.deepEqual(head.target,prior.target);assert.deepEqual(head.baseline,prior.baseline);assert.equal(head.note,'After ');});
test('Classic feedback is durably queued locally with Auto-Sync Off and reopens without a remote write',async t=>{const s=await editorSetup(t),records=s.editor.working().domain.records,r=records.find(r=>r.recordId==='fixture:guide'),town=records.find(r=>r.kind==='map');const spec={type:'review',key:'prompt:fixture:point-guide:entry:fixture:block-guide:0',context:{townId:town.recordId,pointId:'fixture:point-guide',scope:'prompt',passageKeys:['entry:fixture:block-guide:0'],gender:'male'},after:{note:'Saved offline ',flag:true}};const current=s.editor.working(),command=C.command(current.domain,spec);s.editor.queue(command,current.head);assert.equal(s.transport.creationCount,0);await s.reopen();assert.equal(s.editor.working().domain.reviews.at(-1).note,'Saved offline ');assert.equal(s.editor.working().domain.reviews.at(-1).target.recordId,r.recordId);assert.equal(s.transport.creationCount,0);});
