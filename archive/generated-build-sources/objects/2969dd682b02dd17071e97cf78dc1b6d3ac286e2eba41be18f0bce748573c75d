import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';
import {parseJSON,validateArtifact,canonical,seal,sha,conforms,validateGraph} from '../content/contracts.mjs';
import {ContentCache} from '../content/cache.mjs';import {ContentReader} from '../content/reader.mjs';
import {projectNPCDex} from '../content/projection.mjs';import {validateDomain} from '../cloud/npcdex-domain.mjs';
import {FixtureContentTransport,example} from './content-fixture.mjs';
const bytes=x=>Buffer.from(typeof x==='string'?x:JSON.stringify(x));
function setup(t,{fault=()=>{},maxBytes}={}){const directory=fs.mkdtempSync(path.join(os.tmpdir(),'romdex-content-')),transport=new FixtureContentTransport(),seed=transport.seed();let cache=new ContentCache({directory,workspace:'fixture:workspace',isolation:true,fault,maxBytes});let enabled=true;const reader=()=>new ContentReader({transport,cache,workspace:'fixture:workspace',bootstrapPublication:seed.pub.digest,enabled:()=>enabled});t.after(()=>{try{cache.close();}catch{}fs.rmSync(directory,{recursive:true,force:true});});return {transport,seed,get cache(){return cache;},directory,reader,setEnabled:value=>enabled=value,reopen(){cache.close();cache=new ContentCache({directory,workspace:'fixture:workspace',isolation:true});}};}
test('Strict JSON preserves exact whitespace and Unicode and rejects lossy input',()=>{
 assert.equal(parseJSON(bytes('{"text":"word "}')).text,'word ');assert.equal(canonical({z:'é',a:1}),'{'+'"a":1,"z":"é"}');
 for(const raw of ['{"a":1,"a":2}','{"__proto__":{}}','{"constructor":1}','{"text":"\\ud800"}','[9007199254740992]','[-0]','[1.5]','{"a":1} trailing','[1,]','{"a":1,}'])assert.throws(()=>parseJSON(bytes(raw)),raw);
 assert.throws(()=>parseJSON(Buffer.from([0xff])));assert.throws(()=>parseJSON(Buffer.from([0xef,0xbb,0xbf,0x31])));assert.throws(()=>parseJSON(bytes('[[[0]]]'),{maxDepth:1}));assert.throws(()=>parseJSON(bytes('[1,2]'),{maxNodes:2}));assert.throws(()=>parseJSON(bytes('"large"'),{maxBytes:2}));
});
test('Pinned contract validation checks schema, workspace and digest',()=>{const p=example('map-package');assert(conforms(p));assert(validateArtifact(bytes(p),'fixture:workspace'));const invalid=structuredClone(p);invalid.instructions.push('Changed');assert.throws(()=>validateArtifact(bytes(invalid),'fixture:workspace'));assert.throws(()=>validateArtifact(bytes(p),'fixture:other'));const r=structuredClone(p.recordSnapshots[0]);r.extra=true;assert(!conforms(r));});
test('Graph validation rejects cycles, wrong profiles and absent inverse membership',()=>{const records=example('map-package').recordSnapshots;validateGraph(records);for(const mutate of [r=>r[1].parentRecordId=r[1].recordId,r=>r.find(r=>r.kind==='appearance').current.payload.profileId='missing',r=>r.find(r=>r.kind==='subzone').current.payload.appearanceIds=[]]){const changed=structuredClone(records);mutate(changed);assert.throws(()=>validateGraph(changed.map(seal)));}});
test('Unconfigured or production-profile cache paths cannot activate this preview',t=>{const directory=fs.mkdtempSync(path.join(os.tmpdir(),'rdx-reject-'));t.after(()=>fs.rmSync(directory,{recursive:true,force:true}));assert.throws(()=>new ContentCache({directory,workspace:'fixture:workspace'}));assert.throws(()=>new ContentCache({directory,workspace:'production',isolation:true}));assert.throws(()=>new ContentCache({directory:path.join(directory,'ROMDexDesktop/Data/live'),workspace:'fixture:workspace',isolation:true}));});
test('A complete baseline assembles a valid NPCDex view with stable IDs and proposals',async t=>{const s=setup(t),reader=s.reader(),view=await reader.cycle(true);assert.equal(view.status.attention,false,JSON.stringify(view.review));assert(view.active);validateDomain(view.snapshot);assert.equal(view.snapshot.towns[0].id,'fixture:map');assert.equal(view.snapshot.towns[0].characters.find(c=>c.id==='fixture:guide').name,'Guide');assert.equal(view.snapshot.contentPreview.plans.length,4);assert(view.snapshot.towns[0].characters.some(c=>c.name.includes('Planned Addition')));const again=await reader.cycle(true);assert.equal(again.snapshot.revision,view.snapshot.revision);});
test('Native titles changed outside the contract are visible review conditions',async t=>{const s=setup(t),r=s.reader();const original=await r.cycle(true);const binding=s.transport.bindings.find(b=>b.recordId==='fixture:guide');s.transport.issues.get(binding.issueId).summary='Changed Natively';const view=await r.cycle(true);assert(view.status.attention);assert.equal(view.head,original.head);assert(view.review.some(x=>x.message.includes('Native Metadata')));});
test('Incomplete dependent correction preserves the view through restart, then applies together',async t=>{const s=setup(t);let r=s.reader();const original=await r.cycle(true);const update=s.transport.correction(s.seed.pub.digest),missing=update.carrier.artifacts[1].object.chunks[0].attachmentId,held=s.transport.attachments.get(missing);s.transport.attachments.delete(missing);let view=await r.cycle(true);assert(view.status.attention);assert.equal(view.head,original.head);s.reopen();r=s.reader();assert.equal(r.view().head,original.head);view=await r.cycle(true);assert.equal(view.head,original.head);s.transport.attachments.set(missing,held);view=await r.cycle(true);assert.equal(view.status.attention,false,JSON.stringify(view.review));assert.equal(view.head,update.pub.digest);assert.equal(view.snapshot.contentPreview.plans.length,4);});
test('Two conflicting branches roll back to a common ancestor and preserve both heads',async t=>{const s=setup(t),r=s.reader();await r.cycle(true);const first=s.transport.correction(s.seed.pub.digest,'First Branch','first');assert.equal((await r.cycle(true)).head,first.pub.digest);const second=s.transport.correction(s.seed.pub.digest,'Second Branch','second');const view=await r.cycle(true);assert.equal(view.head,s.seed.pub.digest);const conflict=view.review.find(x=>x.kind==='competing-publications');assert(conflict.heads.includes(first.pub.digest)&&conflict.heads.includes(second.pub.digest));assert(s.cache.get('domain:'+first.pub.digest)&&s.cache.get('domain:'+second.pub.digest));});
test('Missing history remains a warning across repeated discovery and restart',async t=>{const s=setup(t);let r=s.reader();await r.cycle(true);const update=s.transport.correction(s.seed.pub.digest);await r.cycle(true);s.transport.attachments.delete(update.ref.attachmentId);for(let i=0;i<2;i++){const view=await r.cycle(true);assert.equal(view.head,update.pub.digest);assert(view.review.some(x=>x.kind==='missing-history'));}s.reopen();r=s.reader();const view=await r.cycle(true);assert(view.review.some(x=>x.kind==='missing-history'));assert.equal(view.head,update.pub.digest);});
test('Unauthorized, null-author, corrupt bytes and unknown workflow do not replace accepted data',async t=>{for(const mode of ['author','corrupt','workflow']){const s=setup(t),r=s.reader(),base=await r.cycle(true);let next;if(mode==='workflow'){const result=example('dialogue-result');next=s.transport.publish({kind:'implementation',parent:s.seed.pub.digest,artifacts:[result,...result.recordUpdates.map(x=>x.after)],resultDigest:result.digest});}else{next=s.transport.correction(s.seed.pub.digest);const ref=next.carrier.artifacts[0].object.chunks[0];if(mode==='author')s.transport.attachments.get(ref.attachmentId).meta.authorId=null;else s.transport.attachments.get(ref.attachmentId).bytes[20]^=1;}const view=await r.cycle(true);assert.equal(view.head,base.head);assert(view.status.attention,mode);}});
test('Tampering under a previously observed manifest ID is held even if the server size matches',async t=>{const s=setup(t),r=s.reader();const base=await r.cycle(true);const a=s.transport.attachments.get(s.seed.ref.attachmentId);a.bytes=Buffer.from(a.bytes);a.bytes[a.bytes.length-3]^=1;const view=await r.cycle(true);assert.equal(view.head,base.head);assert(view.status.attention);assert(view.review.some(x=>x.message.includes('Manifest Changed')));});
test('Auto-Sync Off performs no reads; manual cycle is one pass and keeps Off',async t=>{const s=setup(t),r=s.reader();s.setEnabled(false);const before=s.transport.reads;await r.cycle();assert.equal(s.transport.reads,before);const view=await r.cycle(true);assert(view.active);assert.equal(view.status.automaticRemote,false);await r.cycle();assert.equal(s.transport.reads,before+1);});
test('Offline reads retain the accepted snapshot across a new reader process boundary',async t=>{const s=setup(t);let r=s.reader();const good=await r.cycle(true);s.transport.fail=true;s.reopen();r=s.reader();const view=await r.cycle(true);assert.equal(view.head,good.head);assert.deepEqual(view.snapshot,good.snapshot);assert.equal(view.status.connection,'unavailable');});
test('SQLite transaction failure cannot acknowledge a new projection',async t=>{let fail=false;const s=setup(t,{fault:()=>{if(fail)throw Error('Injected Commit Failure');}}),r=s.reader();const good=await r.cycle(true);s.transport.correction(s.seed.pub.digest);fail=true;const view=await r.cycle(true);assert.equal(view.head,good.head);assert(view.status.attention);fail=false;s.reopen();assert.equal(s.reader().view().head,good.head);});
test('A cache quota failure retains the last accepted state',async t=>{const s=setup(t),r=s.reader(),good=await r.cycle(true);s.cache.maxBytes=1;s.transport.correction(s.seed.pub.digest);const view=await r.cycle(true);assert.equal(view.head,good.head);assert(view.status.attention);});
test('A cached byte-integrity failure is surfaced without deleting cache data',t=>{const s=setup(t),hash=s.cache.putObject(bytes('fixture'));s.cache.db.prepare('UPDATE objects SET bytes=? WHERE hash=?').run(bytes('tampered'),hash);assert.throws(()=>s.cache.object(hash),/Verification/);});
test('A different bootstrap cannot reuse an existing isolated cache',async t=>{const s=setup(t);await s.reader().cycle(true);assert.throws(()=>new ContentReader({transport:s.transport,cache:s.cache,workspace:'fixture:workspace',bootstrapPublication:'0'.repeat(64)}),/Binding Changed/);});
test('Projection resolves local player-gender profiles and resets stale testing display',()=>{const pkg=example('map-package'),records=structuredClone(pkg.recordSnapshots);const guide=records.find(r=>r.recordId==='fixture:guide');guide.current.payload.profileByPlayerGender.female='fixture:profile-visitor';const domain={records:records.map(seal),plans:[],reviews:[],mappings:[],assets:[],revisions:records.map(seal)};const male=projectNPCDex(domain),female=projectNPCDex(domain,{gender:'female'});assert.equal(male.towns[0].characters.find(c=>c.id==='fixture:guide').name,'Guide');assert.equal(female.towns[0].characters.find(c=>c.id==='fixture:guide').name,'Visitor');assert.equal(female.preferences.gender,'female');});
test('Speaker profiles are mapped to the explicit local appearance without losing profile identity',()=>{const p=example('map-package'),domain={records:p.recordSnapshots,plans:[],reviews:[],mappings:[],assets:[],revisions:p.recordSnapshots};const projected=projectNPCDex(domain),block=projected.towns[0].areas[0].elements.find(e=>e.id==='fixture:guide').points[0].blocks[0];assert.equal(block.speaker,'fixture:guide');assert.equal(block.speakerProfileId,'fixture:profile-guide');});
test('A changed content revision displays old verified testing as unreviewed',()=>{const p=example('map-package'),review=structuredClone(p.observations[0].review);review.testStatus='verified';const records=structuredClone(p.recordSnapshots),guide=records.find(r=>r.recordId==='fixture:guide');guide.current.payload.points['fixture:point-guide'].blocks['fixture:block-guide'].text='Changed Content';const domain={records:records.map(seal),plans:[],reviews:[seal(review)],mappings:[],assets:[],revisions:p.recordSnapshots};const result=projectNPCDex(domain);assert.equal(result.contentPreview.reviewStates[0].status,'unreviewed');assert.equal(result.contentPreview.reviewStates[0].stale,true);assert.equal(result.contentPreview.reviews[0].testStatus,'verified');});
test('A fresh client can show its verified baseline while a later publication is incomplete',async t=>{const s=setup(t);const update=s.transport.correction(s.seed.pub.digest);s.transport.attachments.delete(update.carrier.artifacts[1].object.chunks[0].attachmentId);const view=await s.reader().cycle(true);assert(view.active);assert.equal(view.head,s.seed.pub.digest);assert(view.status.attention);});
test('Chunked objects are assembled and verified before projection',async t=>{const s=setup(t),r=s.reader();await r.cycle(true);const update=s.transport.correction(s.seed.pub.digest),meta=s.transport.attachments.get(update.ref.attachmentId),carrier=JSON.parse(meta.bytes);const ref=carrier.artifacts[0].object.chunks[0],original=s.transport.attachments.get(ref.attachmentId).bytes,mid=Math.floor(original.length/2);carrier.artifacts[0].object.chunks=[s.transport.put(ref.issueId,original.subarray(0,mid)),s.transport.put(ref.issueId,original.subarray(mid))];s.transport.attachments.delete(update.ref.attachmentId);s.transport.put(s.transport.registryIssueId,Buffer.from(JSON.stringify(seal(carrier))),'npcdex-publication.json');const view=await r.cycle(true);assert.equal(view.head,update.pub.digest);assert.equal(view.status.attention,false,JSON.stringify(view.review));});
test('Duplicate physical carriers with identical semantic bindings do not create competing versions',async t=>{const s=setup(t),r=s.reader();const original=await r.cycle(true);const bytes=s.transport.attachments.get(s.seed.ref.attachmentId).bytes;s.transport.put(s.transport.registryIssueId,bytes,'npcdex-publication.json');const view=await r.cycle(true);assert.equal(view.head,original.head);assert.equal(view.status.attention,false);});
test('Unpublished owner files remain pending without replacing current content or flashing a review warning',async t=>{const s=setup(t),r=s.reader(),good=await r.cycle(true);const recordIssue=s.transport.bindings[0].issueId;s.transport.put(recordIssue,bytes('Owner Staged File'),'not-published.bin');const view=await r.cycle(true);assert.equal(view.head,good.head);assert.equal(view.status.attention,false);assert.equal(view.status.pendingIncomingFiles,1);});
test('Unpublished files from another actor are visible review conditions',async t=>{const s=setup(t),r=s.reader(),good=await r.cycle(true);const ref=s.transport.put(s.transport.bindings[0].issueId,bytes('Unapproved File'),'unrecognized.json');s.transport.attachments.get(ref.attachmentId).meta.authorId=null;const view=await r.cycle(true);assert.equal(view.head,good.head);assert(view.review.some(x=>x.kind==='unapproved-file'));});
test('Deleting a published entity artifact remains a missing-history warning on every refresh',async t=>{const s=setup(t),r=s.reader(),good=await r.cycle(true);const ref=s.seed.carrier.artifacts.find(a=>a.object.chunks[0].issueId!==s.transport.registryIssueId).object.chunks[0];s.transport.attachments.delete(ref.attachmentId);for(let i=0;i<2;i++){const view=await r.cycle(true);assert.equal(view.head,good.head);assert(view.review.some(x=>x.kind==='missing-history'));}});
for(const field of ['descriptionSha256','commentsSha256'])test('Native '+field+' changes require review and retain accepted content',async t=>{const s=setup(t),r=s.reader(),good=await r.cycle(true);s.transport.issues.get(s.transport.bindings[0].issueId)[field]=sha('Changed Outside the Contract');const view=await r.cycle(true);assert.equal(view.head,good.head);assert(view.status.attention);assert(view.review.some(x=>x.message.includes('Native Metadata')));});
test('Intentional stop pauses an incoming cycle and manual sync can resume while automatic sync is Off',async t=>{const s=setup(t),r=s.reader();const good=await r.cycle(true);s.transport.correction(s.seed.pub.digest);s.setEnabled(false);const discover=s.transport.discover.bind(s.transport);let entered;const started=new Promise(resolve=>entered=resolve);s.transport.discover=async()=>{entered();await new Promise(resolve=>s.transport.signal.addEventListener('abort',resolve,{once:true}));throw Error('Stopped');};const pending=r.cycle(true);await started;r.stop();const paused=await pending;assert.equal(paused.head,good.head);assert.equal(paused.status.connection,'paused');assert.equal(paused.status.attention,false);s.transport.discover=discover;const resumed=await r.cycle(true);assert.notEqual(resumed.head,good.head);assert.equal(resumed.status.automaticRemote,false);assert.equal(resumed.status.attention,false);});
