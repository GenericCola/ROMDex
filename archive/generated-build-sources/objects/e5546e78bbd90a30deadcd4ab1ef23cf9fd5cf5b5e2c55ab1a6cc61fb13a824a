import test from 'node:test';import assert from 'node:assert/strict';import {document as original} from './cloud-merge-fixture.mjs';import {previewLegacyMigration,recoverLegacyOriginal} from '../content/migration.mjs';import {buildNativeViewTransition,buildContentImport} from '../content/catalog.mjs';import {projectNPCDex} from '../content/projection.mjs';import {buildEdit} from '../content/edits.mjs';import {sha,seal} from '../content/contracts.mjs';import {applyPublication,validateDomain} from '../content/materialize.mjs';
import {nativeFixture,mapBundle} from './content-native-tree-fixture.mjs';
import {buildResolution} from '../content/edits.mjs';

const importMap=(f,bundle=mapBundle(f))=>buildContentImport(f.domain,Buffer.from(JSON.stringify(bundle)),{...f.ctx,head:f.transition.publication.digest});
test('Native transition preserves the complete original view without reading the recovery export',()=>{const f=nativeFixture(),before=projectNPCDex(f.p.domain,{revision:73,assetBytes:f.assetBytes}),originalHash=f.p.domain.assets.find(a=>a.assetId===f.p.manifest.source.assetId).sha256,after=projectNPCDex(f.domain,{revision:73,assetBytes:h=>{assert.notEqual(h,originalHash);return f.assetBytes(h);}});delete before.contentPreview;delete after.contentPreview;assert.deepEqual(after,before);assert.deepEqual(f.domain.records,f.p.domain.records);assert.deepEqual(f.domain.plans,f.p.domain.plans);assert(recoverLegacyOriginal(f.domain,f.assetBytes).bytes.equals(Buffer.from(JSON.stringify(f.d))));});
test('New map, zone, profile and entity appear without extending original export or migrated IDs',()=>{const f=nativeFixture(),edit=importMap(f),view=projectNPCDex(edit.preview,{assetBytes:f.assetBytes});assert.equal(view.towns.length,2);const town=view.towns.find(t=>t.id==='fixture:new-map');assert.equal(town.name,'New Map');assert.equal(town.locations[0].name,'New House');assert.equal(town.characters[0].name,'New Person');assert.equal(town.areas[0].elements[0].points[0].blocks[0].text,'New dialogue ');assert.equal(view.towns[0].areas[0].elements[0].points[0].blocks[0].text,'Original Dialogue');assert.deepEqual(edit.preview.records.find(r=>r.recordId===f.domain.records[0].recordId),f.domain.records[0]);});
test('Import is deterministic and replays from its pinned parent, with duplicate identities rejected',()=>{const f=nativeFixture(),a=importMap(f),b=importMap(f);assert.equal(a.publication.digest,b.publication.digest);assert.deepEqual(applyPublication(f.domain,a.publication,a.artifacts,[]),a.preview);assert.throws(()=>buildContentImport(a.preview,Buffer.from(JSON.stringify({...mapBundle(f),expectedHead:a.publication.digest})),{...f.ctx,head:a.publication.digest}),/Existing or Duplicate/);});
test('Stale heads and cross-workspace bundles cannot be imported',()=>{const f=nativeFixture(),b=mapBundle(f);b.expectedHead='b'.repeat(64);assert.throws(()=>importMap(f,b),/Baseline/);b.expectedHead=f.transition.publication.digest;b.workspaceId='fixture:other';assert.throws(()=>importMap(f,b),/Workspace/);});
test('Invalid parent membership or missing shared profile is rejected',()=>{const f=nativeFixture(),b=mapBundle(f);b.records[3].current.payload.profileId='fixture:missing';assert.throws(()=>importMap(f,b),/Reference/);const c=mapBundle(f);c.records[1].current.payload.appearanceIds=[];assert.throws(()=>importMap(f,c),/Membership/);});
test('Import cannot replace an existing item or claim an existing legacy identity',()=>{const f=nativeFixture(),b=mapBundle(f);b.records[0].recordId=f.domain.records.find(r=>r.kind==='map').recordId;assert.throws(()=>importMap(f,b),/Existing or Duplicate/);const c=mapBundle(f);c.records[0].legacyRefs=[];assert.throws(()=>importMap(f,c),/Existing or Duplicate/);});
test('A catalog publication cannot rewrite an existing current dialogue',()=>{const f=nativeFixture(),edit=importMap(f),r=f.domain.records.find(r=>r.kind==='appearance'),after=seal({...r,operationId:'fixture:malicious',parents:[r.revisionId],current:{...r.current,payload:{...r.current.payload,name:'Unauthorized replacement'}}}),receipt=seal({...edit.artifacts[0],recordChanges:[...edit.artifacts[0].recordChanges,{recordId:r.recordId,beforeRevision:r.revisionId,afterRevision:after.revisionId}]}),artifacts=[receipt,...edit.artifacts.slice(1),after],publication=seal({...edit.publication,resultDigest:receipt.digest,artifactDigests:artifacts.map(a=>a.revisionId||a.digest)});assert.throws(()=>applyPublication(f.domain,publication,artifacts,[]),/Only Extend/);});
test('Locator traversal and unsupported verification claims are rejected',()=>{const f=nativeFixture(),b=mapBundle(f);b.records[0].mapping.locators=[{kind:'map',adapter:'documented-map/1',path:'../secret',fileSha256:null,selectors:{}}];assert.throws(()=>importMap(f,b),/Project-Relative/);const c=mapBundle(f);c.source.verification='rom-verified';assert.throws(()=>importMap(f,c),/Documented Source/);});
test('Presentation metadata cannot hide an embedded legacy tree or reference a missing record',()=>{const f=nativeFixture(),root=f.domain.views.find(v=>v.viewId==='view:root'),bad=seal({...root,payload:{...root.payload,fields:{...root.payload.fields,towns:[]}}});assert.throws(()=>validateDomain({...f.domain,views:f.domain.views.map(v=>v===root?bad:v)}),/Root Metadata/);const missing=seal({...root,payload:{...root.payload,collectionOrder:['fixture:missing']}});assert.throws(()=>validateDomain({...f.domain,views:f.domain.views.map(v=>v===root?missing:v)}),/Native Collection/);});
test('Content corrections and planned additions work after native transition without stale root data overwriting them',()=>{const f=nativeFixture(),r=f.domain.records.find(r=>r.kind==='appearance'),p=Object.values(r.current.payload.points)[0],bid=p.blockOrder[0],edit=buildEdit(f.domain,{type:'definition',recordId:r.recordId,pointId:p.id,blockId:bid,dialogue:'Corrected native current ',documentationCorrection:true,reason:'Documentation correction',evidence:'Synthetic evidence'},{...f.ctx,head:f.transition.publication.digest,operationId:'fixture:correct-native'});const view=projectNPCDex(edit.preview,{assetBytes:f.assetBytes});assert.equal(view.towns[0].areas[0].elements[0].points[0].blocks[0].text,'Corrected native current ');assert.deepEqual(view.unknownFuture,f.d.unknownFuture);});
test('An import cannot substitute a different timeline or invent a migration record',()=>{const f=nativeFixture(),b=mapBundle(f);b.records[0].current.payload.timelineRef='fixture:another-timeline';assert.throws(()=>importMap(f,b),/Existing Shared Timeline/);const c=mapBundle(f);c.records[0].current.payload.definitions={migration:{}};assert.throws(()=>importMap(f,c),/Migration Evidence/);});
test('Imported image bytes must match their declared signature, not merely dimensions',()=>{const f=nativeFixture(),b=mapBundle(f),data=Buffer.alloc(33);data.writeUInt32BE(13,8);data.write('IHDR',12);data.writeUInt32BE(1,16);data.writeUInt32BE(1,20);b.assets=[{assetId:'content:asset-'+sha(data),mime:'image/png',base64:data.toString('base64'),sha256:sha(data),bytes:data.length}];assert.throws(()=>importMap(f,b),/Signature/);});
test('Two independent map imports retain both maps and merge root ordering during reviewed resolution',()=>{const f=nativeFixture(),a=importMap(f),b=mapBundle(f);for(const r of b.records){r.recordId=r.recordId.replace('new-','other-');if(r.parentRecordId)r.parentRecordId=r.parentRecordId.replace('new-','other-');r.current=JSON.parse(JSON.stringify(r.current).replaceAll('fixture:new-','fixture:other-'));}const second=importMap(f,b),resolution=buildResolution([a.preview,second.preview],[a.publication.digest,second.publication.digest],{}, {...f.ctx,operationId:'fixture:review-imports'});const view=projectNPCDex(resolution.preview,{assetBytes:f.assetBytes});assert(view.towns.some(t=>t.id==='fixture:new-map'));assert(view.towns.some(t=>t.id==='fixture:other-map'));assert.equal(resolution.preview.views.filter(v=>v.viewId==='view:root').length,1);});
test('A presentation transition cannot omit metadata for an existing item',()=>{const f=nativeFixture(),artifacts=f.transition.artifacts.filter(a=>a.recordId!==f.domain.records.find(r=>r.kind==='profile').recordId),receipt=seal({...artifacts[0],viewDigests:artifacts.slice(1).map(v=>v.digest)});artifacts[0]=receipt;const pub=seal({...f.transition.publication,artifactDigests:artifacts.map(a=>a.digest),resultDigest:receipt.digest});assert.throws(()=>applyPublication(f.p.domain,pub,artifacts,[]),/Every Existing Display Target/);});
test('Invalid native map identities and cross-zone area collisions fail in preview rather than after queueing',()=>{const f=nativeFixture(),b=mapBundle(f);b.records[0].presentation={fields:{id:f.d.towns[0].id}};assert.throws(()=>importMap(f,b),/Duplicate Native Map Identity/);const c=mapBundle(f);c.records[0].presentation={fields:{id:{invalid:true}}};assert.throws(()=>importMap(f,c),/Must Be Text/);const d=mapBundle(f),zone=structuredClone(d.records[1]);zone.recordId='fixture:second-zone';zone.current.payload.name='Second House';zone.current.payload.appearanceIds=[];zone.presentation={areas:[{id:'duplicate-area',name:'Second Area'}]};d.records[1].presentation={areas:[{id:'duplicate-area',name:'First Area'}]};d.records[0].current.payload.subzoneIds.push(zone.recordId);d.records.push(zone);assert.throws(()=>importMap(f,d),/Duplicate Native Area/);});
