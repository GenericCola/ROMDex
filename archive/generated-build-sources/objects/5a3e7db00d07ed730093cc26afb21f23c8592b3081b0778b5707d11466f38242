import fs from 'node:fs';import path from 'node:path';import {DatabaseSync} from 'node:sqlite';
import {sha,requireThat,parseJSON} from './contracts.mjs';
const domainKeys=['records','plans','reviews','mappings','assets','revisions'];
import {workspaceAllowed} from './authorization.mjs';

// Fixture caches remain isolated; accepted migrations use a separately pinned context.
export class ContentCache{
 constructor({directory,workspace,isolation=false,authorization=null,maxBytes=256*1024*1024,fault=()=>{}}){
  const live=typeof workspace==='string'&&!workspace.startsWith('fixture:');requireThat(workspaceAllowed(workspace,authorization)&&(!live?isolation===true:true),'An Explicit Content Cache Context Is Required.');
  directory=path.resolve(directory);const production=/[\\/]ROMDexDesktop[\\/]Data(?:[\\/]|$)/i.test(directory),approvedPath=/[\\/]ROMDexDesktop[\\/]Data[\\/]thegobindsingh-PMON[\\/]cloud[\\/]content$/i.test(directory);requireThat(!production||live&&!isolation&&approvedPath,'The Production Data Folder Is Not a Preview Cache.');requireThat(isolation||live&&approvedPath,'An Accepted Live Cache Must Use Its Dedicated Content Folder.');
  let ancestor=directory;while(!fs.existsSync(ancestor))ancestor=path.dirname(ancestor);requireThat(!/[\\/]ROMDexDesktop[\\/]Data(?:[\\/]|$)/i.test(fs.realpathSync(ancestor))||production&&live&&!isolation&&approvedPath,'A Preview Path Cannot Resolve Into Production Data.');
  fs.mkdirSync(directory,{recursive:true});for(let part=directory;path.dirname(part)!==part;part=path.dirname(part))requireThat(!fs.lstatSync(part).isSymbolicLink(),'Content Cache Links Are Not Allowed.');requireThat(path.resolve(fs.realpathSync(directory)).toLowerCase()===directory.toLowerCase(),'Content Cache Must Use Its Real Path.');
  const marker=path.join(directory,'content-isolation.json'),identity={format:live?'ROMDexAcceptedContentCache/1':'ROMDexContentPreview/1',workspace,...(live?{sourceSHA256:authorization.sourceSHA256}:{} )};
  if(fs.existsSync(marker))requireThat(JSON.stringify(parseJSON(fs.readFileSync(marker)))===JSON.stringify(identity),'Preview Cache Belongs to Another Workspace.');
  else fs.writeFileSync(marker,JSON.stringify(identity),{flag:'wx'});
  Object.assign(this,{directory,workspace,maxBytes,fault});this.db=new DatabaseSync(path.join(directory,'content.sqlite'));
  this.db.exec('PRAGMA journal_mode=WAL; PRAGMA synchronous=FULL; PRAGMA busy_timeout=2000; CREATE TABLE IF NOT EXISTS objects(hash TEXT PRIMARY KEY,bytes BLOB NOT NULL); CREATE TABLE IF NOT EXISTS state(key TEXT PRIMARY KEY,bytes BLOB NOT NULL,hash TEXT NOT NULL);');
  requireThat(this.db.prepare('PRAGMA quick_check').get().quick_check==='ok','The Content Cache Needs Recovery.');
 }
 transaction(fn){this.db.exec('BEGIN IMMEDIATE');try{const result=fn();this.fault('before-commit');this.db.exec('COMMIT');return result;}catch(error){this.db.exec('ROLLBACK');throw error;}}
 object(hash){const row=this.db.prepare('SELECT bytes FROM objects WHERE hash=?').get(hash);if(!row)return null;const bytes=Buffer.from(row.bytes);requireThat(sha(bytes)===hash,'Cached Content Object Failed Verification.');return bytes;}
 has(key){return !!this.db.prepare('SELECT 1 FROM state WHERE key=?').get(key);}
 putObject(bytes){const hash=sha(bytes),existing=this.object(hash);if(existing){requireThat(existing.equals(bytes),'Cached Object Collision.');return hash;}const size=Number(this.db.prepare('SELECT (SELECT coalesce(sum(length(bytes)),0) FROM objects)+(SELECT coalesce(sum(length(bytes)),0) FROM state) AS size').get().size);requireThat(size+bytes.length<=this.maxBytes,'The Content Cache Reached Its Storage Bound.');this.db.prepare('INSERT INTO objects(hash,bytes) VALUES(?,?)').run(hash,bytes);return hash;}
 // Share immutable verified objects; keep original histories without duplicating
 // the complete export for each publication and each upload-slot intent.
 packDomain(domain){requireThat(domain&&domainKeys.every(k=>Array.isArray(domain[k]))&&Object.keys(domain).every(k=>domainKeys.includes(k)),'Invalid Cached Domain Shape.');return {format:'ROMDexContentDomainRefs/1',collections:Object.fromEntries(domainKeys.map(k=>[k,domain[k].map(value=>this.putObject(Buffer.from(JSON.stringify(value))))]))};}
 unpackDomain(refs){requireThat(refs.format==='ROMDexContentDomainRefs/1'&&domainKeys.every(k=>Array.isArray(refs.collections?.[k])),'Invalid Cached Domain References.');const memo=new Map();return Object.fromEntries(domainKeys.map(k=>[k,refs.collections[k].map(hash=>{if(!memo.has(hash)){const bytes=this.object(hash);requireThat(bytes,'A Retained Content Dependency Is Missing.');memo.set(hash,parseJSON(bytes));}return memo.get(hash);})]));}
 encodeState(key,value){if(key.startsWith('domain:'))return this.packDomain(value);if(key==='edit-journal'||key.startsWith('archived-edit:')){const pack=op=>({...op,preview:this.packDomain(op.preview)});return Array.isArray(value)?value.map(pack):pack(value);}return value;}
 decodeState(key,value){if(key.startsWith('domain:')&&value.format==='ROMDexContentDomainRefs/1')return this.unpackDomain(value);if(key==='edit-journal'||key.startsWith('archived-edit:')){const unpack=op=>op.preview?.format==='ROMDexContentDomainRefs/1'?{...op,preview:this.unpackDomain(op.preview)}:op;return Array.isArray(value)?value.map(unpack):unpack(value);}return value;}
 get(key){const row=this.db.prepare('SELECT bytes,hash FROM state WHERE key=?').get(key);if(!row)return null;const bytes=Buffer.from(row.bytes);requireThat(sha(bytes)===row.hash,'Cached Content State Failed Verification.');return this.decodeState(key,parseJSON(bytes));}
 set(key,value){const bytes=Buffer.from(JSON.stringify(this.encodeState(key,value)));parseJSON(bytes);const hash=sha(bytes),previous=this.db.prepare('SELECT bytes,hash FROM state WHERE key=?').get(key);if(previous?.hash===hash){requireThat(sha(Buffer.from(previous.bytes))===hash,'Cached Content State Failed Verification.');return;}const size=Number(this.db.prepare('SELECT (SELECT coalesce(sum(length(bytes)),0) FROM objects)+(SELECT coalesce(sum(length(bytes)),0) FROM state WHERE key<>?) AS size').get(key).size);requireThat(size+bytes.length<=this.maxBytes,'The Content Cache Reached Its Storage Bound.');this.db.prepare('INSERT INTO state(key,bytes,hash) VALUES(?,?,?) ON CONFLICT(key) DO UPDATE SET bytes=excluded.bytes,hash=excluded.hash').run(key,bytes,hash);}
 retainOperations(operations){const pending=operations.filter(op=>!['committed','cancelled'].includes(op.state));requireThat(pending.length<=200,'The Content Journal Has 200 Pending Operations; Resolve Them Before Adding Work.');const terminal=operations.filter(op=>['committed','cancelled'].includes(op.state)),archive=terminal.slice(0,Math.max(0,terminal.length-32));for(const op of archive)this.set('archived-edit:'+op.id,op);const archived=new Set(archive.map(op=>op.id));this.set('edit-journal',operations.filter(op=>!archived.has(op.id)));}
 statistics(){const objects=this.db.prepare('SELECT count(*) AS count,coalesce(sum(length(bytes)),0) AS bytes FROM objects').get(),state=this.db.prepare('SELECT count(*) AS count,coalesce(sum(length(bytes)),0) AS bytes FROM state').get();return {objects:Number(objects.count),objectBytes:Number(objects.bytes),states:Number(state.count),stateBytes:Number(state.bytes),maxBytes:this.maxBytes};}
 checkpoint(){this.db.exec('PRAGMA wal_checkpoint(FULL)');}
 close(){this.checkpoint();this.db.close();}
}
