    PurgeOnUninstall action. Since this package can be installed perUser or perMachine,
    we have to look in both places. First successful search wins. -->
    <SetProperty Id="APPLICATIONROOTDIRECTORY" Action="RestoreInstalledDirectory" Value="[INSTALLPATH]" After="AppSearch" Sequence="both">INSTALLPATH</SetProperty>
<Property Id="INSTALLPATH">
      <RegistrySearch Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{16435520-69F7-428D-B23E-079ABAAE0FFD}.msq"
