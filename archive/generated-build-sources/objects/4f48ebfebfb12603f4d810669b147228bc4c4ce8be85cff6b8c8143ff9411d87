import test from 'node:test';import assert from 'node:assert/strict';
import {YouTrackContentReader} from '../content/youtrack-reader.mjs';import {sha} from '../content/contracts.mjs';
const make=(fetch,options={})=>new YouTrackContentReader({projectId:'0-2',registryIssueId:'3-1000',ownerId:'2-2',credential:async()=> 'synthetic-credential-only',fetch,...options});
const response=(value,status=200)=>new Response(JSON.stringify(value),{status});
const issue={id:'3-1000',summary:'Fixture Registry',project:{id:'0-2'},links:[]};
const content=Buffer.from('fixture');const attachment={id:'12-1',name:'npcdex-publication.json',size:content.length,updated:1,author:{id:'2-2'},url:'/api/files/fixture?signed=synthetic'};
function fake(extra={}){const calls=[];const fetch=async(url,options)=>{calls.push({url:String(url),options});if(extra.handler){const r=await extra.handler(url,options);if(r)return r;}if(url.pathname==='/api/issues/3-1000')return response(issue);if(url.pathname.endsWith('/attachments/12-1'))return response({...attachment,...extra.attachment});if(url.pathname.endsWith('/comments'))return response([]);if(url.pathname.endsWith('/attachments'))return response([attachment]);if(url.pathname==='/api/files/fixture')return new Response(content);throw Error('Unexpected Fixture Route');};return {fetch,calls};}
test('Pinned YouTrack reader sends only GET and never exposes signed URLs from discovery',async()=>{const f=fake(),r=make(f.fetch),listed=await r.discover();assert.equal(listed.length,1);assert(!JSON.stringify(listed).includes('signed='));const read=await r.download('3-1000',{attachmentId:'12-1',bytes:content.length,sha256:sha(content)});assert(read.equals(content));assert(f.calls.every(c=>c.options.method==='GET'&&c.options.redirect==='manual'));assert(f.calls.every(c=>c.options.headers.Authorization==='Bearer synthetic-credential-only'));});
test('Foreign attachment URLs are refused before credentials are sent there',async()=>{const f=fake({attachment:{url:'https://example.invalid/api/files/x'}}),r=make(f.fetch);await assert.rejects(()=>r.download('3-1000',{attachmentId:'12-1',bytes:content.length}),/Download Address/);assert(f.calls.every(c=>!c.url.includes('example.invalid')));});
test('Redirect responses cannot forward the saved credential',async()=>{const f=fake({handler:async url=>url.pathname==='/api/files/fixture'?new Response('',{status:302,headers:{Location:'https://example.invalid'}}):null}),r=make(f.fetch);await assert.rejects(()=>r.download('3-1000',{attachmentId:'12-1',bytes:content.length}),/HTTP 302/);assert(f.calls.every(c=>!c.url.includes('example.invalid')));});
test('Null or unexpected server author is not replaced by an artifact claim',async()=>{for(const author of [null,{id:'2-1'}]){const f=fake({attachment:{author}}),r=make(f.fetch);await assert.rejects(()=>r.download('3-1000',{attachmentId:'12-1',bytes:content.length}),/Author/);assert(!f.calls.some(c=>c.url.includes('/api/files/')));}});
test('A cross-project issue cannot be used to substitute a content attachment',async()=>{const f=fake({handler:async url=>url.pathname==='/api/issues/3-1000'?response({...issue,project:{id:'0-1'}}):null}),r=make(f.fetch);await assert.rejects(()=>r.discover(),/Pinned Project/);});
test('Shifting and truncated pagination cannot declare discovery complete',async()=>{const r=make(async()=>response([{id:'12-1'},{id:'12-2'}]),{pageSize:2,maxPages:2});await assert.rejects(()=>r.list('/api/groups'),/Incomplete/);const q=make(async()=>response([{id:'12-1'},{id:'12-2'},{id:'12-3'}]),{pageSize:2});await assert.rejects(()=>q.list('/api/groups'),/Listing Page/);});
test('Stable discovery retries when a concurrent insertion changes an attachment sweep',async()=>{let listings=0;const f=fake({handler:async url=>url.pathname.endsWith('/attachments')?response(listings++===0?[]:[attachment]):null}),r=make(f.fetch);const result=await r.discover();assert.equal(result.length,1);assert.equal(listings,4);});
test('Changed bytes under a valid attachment ID fail hash verification',async()=>{const f=fake(),r=make(f.fetch);await assert.rejects(()=>r.download('3-1000',{attachmentId:'12-1',bytes:content.length,sha256:'0'.repeat(64)}),/Bytes Do Not Match/);});
test('Response streaming and request-count bounds are enforced',async()=>{const r=make(async()=>new Response(Buffer.alloc(20)));await assert.rejects(()=>r.request('/api/files/x',{binary:true,limit:10}),/Bound/);const s=make(async()=>response(issue),{maxRequests:1});await s.request('/api/issues/3-1000');await assert.rejects(()=>s.request('/api/users/me'),/Budget/);});
test('An interrupted connection error never includes a signed URL or credential',async()=>{const r=make(async()=>{throw Error('synthetic-credential-only signed=synthetic');});await assert.rejects(()=>r.request('/api/issues/3-1000'),error=>!error.message.includes('synthetic')&&error.message.includes('Interrupted'));});
test('A download is canceled by the lifecycle abort signal',async()=>{const controller=new AbortController();controller.abort();const r=make(async(_,options)=>{if(options.signal.aborted)throw Error('aborted');return response(issue);});r.begin(controller.signal);await assert.rejects(()=>r.issue('3-1000'),/Interrupted/);});
