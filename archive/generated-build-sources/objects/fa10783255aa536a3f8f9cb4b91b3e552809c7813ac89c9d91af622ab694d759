import test from 'node:test';import assert from 'node:assert/strict';import {generateKeyPairSync,sign,createHash} from 'node:crypto';import fs from 'node:fs/promises';import path from 'node:path';import os from 'node:os';import {Readable} from 'node:stream';
import {validateRelease,releaseKey,compareVersions,boundedBytes,DAY} from '../desktop/release-core.mjs';
import {stageInstaller,stageLocalInstaller,verifyInstaller} from '../desktop/release-download.mjs';
import {GitHubReleases} from '../desktop/github-releases.mjs';
import {UpdateController} from '../desktop/update-controller.mjs';
import {checkpointBackup,createHandoff} from '../desktop/update-handoff.mjs';
import {EventEmitter} from 'node:events';
const {publicKey,privateKey}=generateKeyPairSync('rsa',{modulusLength:3072}),publicPem=publicKey.export({format:'pem',type:'spki'}),config={publicKey:publicPem,keyId:releaseKey(publicPem).id,provider:{kind:'github'}},now=1760000000000,bytes=Buffer.from('MSI fixture bytes');
const original={application:'ROMDex',channel:'stable',platform:'win32',arch:'x64',version:'0.5.4',minimumVersion:'0.5.2',desktopSchema:1,npcdexSchema:2,publishedAt:now-1000,expiresAt:now+DAY,notes:'Verified Fixture Release',artifact:{provider:'github',id:'123',name:'ROMDex-0.5.4-x64.msi',size:bytes.length,sha256:createHash('sha256').update(bytes).digest('hex')}};
function signed(release=original){const payload=JSON.stringify(release);return {format:'ROMDexRelease/1',keyId:config.keyId,payload,signature:sign('sha256',Buffer.from(payload),privateKey).toString('base64')};}
const validate=(value=signed(),options={})=>validateRelease(value,config,{currentVersion:'0.5.3',now,...options});
async function temporary(t){const allowed=path.resolve(process.env.ROMDEX_TEST_SCRATCH||os.tmpdir()),root=await fs.mkdtemp(path.join(allowed,'romdex-update-'));t.after(async()=>{assert(root.startsWith(allowed+path.sep));await fs.rm(root,{recursive:true,force:true});});return root;}
const response=(value=bytes,length=value.length)=>({ok:true,status:200,headers:new Headers(length===null?{}:{'content-length':String(length)}),body:Readable.from([value.subarray(0,3),value.subarray(3)])});
test('release identity is authenticated before trusting notes, version or artifact bytes',()=>{const r=validate();assert.equal(r.version,'0.5.4');assert(Object.isFrozen(r.artifact));const altered=signed();altered.payload=altered.payload.replace('0.5.4','9.9.9');assert.throws(()=>validate(altered),/Signature/);assert.throws(()=>validate({...signed(),keyId:'wrong'}),/Signature/);assert.throws(()=>validateRelease(signed(),{},{}),/Not Configured/);});
test('wrong platform, application, incompatible saves, stale dates and rollback feeds are rejected',()=>{for(const patch of [{platform:'linux'},{application:'Other'},{desktopSchema:2},{npcdexSchema:3},{expiresAt:now-1},{publishedAt:now+DAY},{expiresAt:now+400*DAY},{minimumVersion:'0.5.4'}])assert.throws(()=>validate(signed({...original,...patch})));assert.throws(()=>validate(signed(),{highestVersion:'0.5.5'}),/Newer Release/);assert.throws(()=>validate(signed(),{currentVersion:'0.5.4'}),/Already Installed/);assert.equal(validate(signed(),{currentVersion:'0.5.4',allowCurrent:true}).version,'0.5.4');});
test('unsafe artifact names, sizes, providers and weak signing keys fail closed',()=>{for(const patch of [{name:'../../installer.msi'},{id:'123/../../x'},{size:-1},{size:2147483648},{sha256:'abc'},{provider:'public'}])assert.throws(()=>validate(signed({...original,artifact:{...original.artifact,...patch}})));assert.throws(()=>validate(signed({...original,artifact:{...original.artifact,provider:'youtrack'}})),/Approved Private Provider/);const weak=generateKeyPairSync('rsa',{modulusLength:2048}).publicKey.export({format:'pem',type:'spki'});assert.throws(()=>releaseKey(weak),/3072/);assert.throws(()=>compareVersions('0.5.3-preview.1','0.5.3'),/Stable/);assert.throws(()=>compareVersions('0.05.3','0.5.3'),/Stable/);});
test('bounded metadata refuses declared or streamed oversized responses',async()=>{assert.equal((await boundedBytes(response(Buffer.from('{}')),8)).toString(),'{}');await assert.rejects(boundedBytes(response(Buffer.alloc(12)),8),/Too Large/);await assert.rejects(boundedBytes(response(Buffer.alloc(12),null),8),/Too Large/);await assert.rejects(boundedBytes({ok:false,status:403}),/403/);});
test('download streams to a private staging file and publishes only verified complete bytes',async t=>{const directory=await temporary(t),release=validate(),progress=[];const file=await stageInstaller({directory,release,approved:true,open:async()=>response(),onProgress:x=>progress.push(x)});assert.equal(await fs.readFile(file,'utf8'),bytes.toString());assert.equal(await verifyInstaller(file,release.artifact),true);assert.equal(progress.at(-1).bytes,bytes.length);assert.deepEqual(await fs.readdir(directory),[release.artifact.name]);});
test('download consent is mandatory and bad, oversized or interrupted bytes never become an installer',async t=>{const directory=await temporary(t),release=validate();let opened=false;await assert.rejects(stageInstaller({directory,release,open:async()=>{opened=true;return response();}}),/Approve/);assert.equal(opened,false);for(const data of [Buffer.from('bad'),Buffer.concat([bytes,bytes]),Buffer.alloc(bytes.length,3)]){await assert.rejects(stageInstaller({directory,release,approved:true,open:async()=>response(data,null)}),/Size|SHA-256/);assert.deepEqual(await fs.readdir(directory),[]);}const abort=new AbortController();await assert.rejects(stageInstaller({directory,release,approved:true,signal:abort.signal,open:async()=>{abort.abort();return response();}}));assert.deepEqual(await fs.readdir(directory),[]);});
test('manual installer staging verifies copies and refuses a preexisting corrupted cached installer',async t=>{const directory=await temporary(t),source=path.join(directory,'source.msi'),cache=path.join(directory,'cache'),release=validate();await fs.writeFile(source,bytes);await fs.mkdir(cache);await fs.writeFile(path.join(cache,release.artifact.name),'corrupt');await assert.rejects(stageLocalInstaller({file:source,directory:cache,release,approved:true}),/Size/);await fs.unlink(path.join(cache,release.artifact.name));const file=await stageLocalInstaller({file:source,directory:cache,release,approved:true});assert.equal(await fs.readFile(file,'utf8'),bytes.toString());});
test('private GitHub asset redirects never send credentials to the asset host and reject other hosts',async()=>{const requests=[];let bad=false;const provider=new GitHubReleases({owner:'GenericCola',repository:'romdex-private-releases',repositoryId:'42',credential:async()=>'synthetic-read-token',fetch:async(url,options)=>{requests.push({url,headers:options.headers});return url.startsWith('https://api.github.com')?new Response(null,{status:302,headers:{location:bad?'https://unapproved.example/asset':'https://release-assets.githubusercontent.com/asset'}}):new Response(bytes);}});assert.equal((await boundedBytes(await provider.request('/releases/assets/123',{binary:true}))).toString(),bytes.toString());assert(requests[0].headers.Authorization);assert.equal(requests[1].headers.Authorization,undefined);bad=true;await assert.rejects(provider.request('/releases/assets/123',{binary:true}),/Redirect Is Not Approved/);assert.equal(requests.length,3);await assert.rejects(provider.request('/../../user'),/Unsupported/);});
test('private hosting must match the pinned repository and cannot silently become public',async()=>{let isPrivate=true;const provider=new GitHubReleases({owner:'GenericCola',repository:'romdex-private-releases',repositoryId:'42',credential:async()=>'synthetic-read-token',fetch:async()=>new Response(JSON.stringify({id:42,full_name:'GenericCola/romdex-private-releases',private:isPrivate}))});assert.equal(await provider.checkAccess(),true);isPrivate=false;await assert.rejects(provider.checkAccess(),/Approved Private Identity/);});
async function controller(t,overrides={}){const directory=await temporary(t),stored={value:null};const instance=new UpdateController({config,version:'0.5.3',directory,now:()=>now,storage:{load:async()=>structuredClone(stored.value),save:async value=>{stored.value=structuredClone(value);}},provider:{configured:true,readIndex:async()=>JSON.stringify(signed()),openArtifact:async()=>response()},...overrides});await instance.init();return {instance,stored,directory};}
test('daily checks fetch metadata only; Later and checks never download installer bytes',async t=>{let checks=0,downloads=0,notices=0;const {instance}=await controller(t,{notify:()=>notices++,provider:{configured:true,readIndex:async()=>{checks++;return JSON.stringify(signed());},openArtifact:async()=>{downloads++;return response();}}});await instance.check();await instance.check();assert.equal(checks,1);assert.equal(notices,1);assert.equal(downloads,0);await instance.later();await instance.check({manual:true});assert.equal(checks,2);assert.equal(notices,1);assert.equal(downloads,0);await assert.rejects(instance.download(),/Approve/);await instance.download({approved:true});assert.equal(downloads,1);assert.equal(instance.snapshot().ready,true);assert.equal((await instance.readyInstaller()).release.version,'0.5.4');});
test('failed feed checks do not erase an already verified update and persisted rollback protection survives restart',async t=>{const {instance,stored,directory}=await controller(t);await instance.check({manual:true});instance.provider.readIndex=async()=>{throw Error('Offline');};await instance.check({manual:true});assert.equal(instance.phase,'error');assert.equal(instance.release.version,'0.5.4');const restarted=new UpdateController({config,version:'0.5.3',directory,now:()=>now,storage:{load:async()=>structuredClone(stored.value),save:async()=>{}},provider:{configured:true,readIndex:async()=>JSON.stringify(signed({...original,version:'0.5.3',artifact:{...original.artifact,name:'ROMDex-0.5.3-x64.msi'}}))}});await restarted.init();await restarted.check({manual:true});assert.equal(restarted.phase,'error');assert.match(restarted.message,/Newer Release/);});
test('tampered cached installers and expired metadata cannot reach installation',async t=>{let clock=now;const {instance}=await controller(t,{now:()=>clock});await instance.check({manual:true});await instance.download({approved:true});const {file}=await instance.readyInstaller();await fs.writeFile(file,'tampered');await assert.rejects(instance.readyInstaller(),/Size/);clock=now+2*DAY;await assert.rejects(instance.readyInstaller(),/Expired/);});
test('unconfigured delivery makes no network request and preserves the signed manual route',async t=>{let called=0;const {instance,directory}=await controller(t,{provider:{configured:false,readIndex:async()=>called++}});await instance.check({manual:true});assert.equal(called,0);assert.equal(instance.snapshot().configured,false);const metadata=path.join(directory,'release.json'),installer=path.join(directory,'original.msi');await fs.writeFile(metadata,JSON.stringify(signed()));await fs.writeFile(installer,bytes);await instance.importLocal({metadata,installer,approved:true});assert.equal(instance.snapshot().ready,true);});
test('update checkpoint retains queued files and encryption state while excluding updater recursion and browser cache',async t=>{const root=await temporary(t),profile=path.join(root,'Data/thegobindsingh-PMON'),directory=path.join(profile,'updates/recovery');await fs.mkdir(path.join(profile,'service/queued-files'),{recursive:true});await fs.writeFile(path.join(profile,'service/queued-files/pending.bin'),'pending-bytes');await fs.mkdir(path.join(profile,'session/Cache'),{recursive:true});await fs.writeFile(path.join(profile,'session/Local State'),'protected-session-key');await fs.writeFile(path.join(profile,'session/Cache/unneeded'),'cache');assert.equal(await checkpointBackup(profile,directory),1);assert.equal(await fs.readFile(path.join(directory,'service/queued-files/pending.bin'),'utf8'),'pending-bytes');assert.equal(await fs.readFile(path.join(directory,'runtime-key/Local State'),'utf8'),'protected-session-key');await assert.rejects(fs.stat(path.join(directory,'session')),{code:'ENOENT'});await assert.rejects(fs.stat(path.join(directory,'updates')),{code:'ENOENT'});});
async function handoffFixture(t){const root=await temporary(t),profile=path.join(root,'Data/thegobindsingh-PMON'),directory=path.join(profile,'updates');await fs.mkdir(path.join(profile,'service'),{recursive:true});await fs.mkdir(directory);await fs.writeFile(path.join(profile,'service/pending.json'),'durable-work');const release=validate(),installer=path.join(directory,release.artifact.name),helperSource=path.join(root,'helper.ps1');await fs.writeFile(installer,bytes);await fs.writeFile(helperSource,'# isolated helper');return {root,profile,directory,release,installer,helperSource,publicKey:publicPem,version:'0.5.3',upgradeCode:'C3861991-512B-4F7D-B1C1-9D8EC7230FDA',utilityPid:999,checkpoint:async()=>{},quiesce:async()=>{},resume:async()=>{}};}
test('installer handoff checkpoints and quiesces before creating a durable plan and waiting for the helper',async t=>{const fixture=await handoffFixture(t),order=[];const result=await createHandoff({...fixture,checkpoint:async()=>order.push('checkpoint'),quiesce:async()=>order.push('quiesce'),launch:(_exe,_args,options)=>{order.push('launch');const child=new EventEmitter();child.unref=()=>{};setTimeout(async()=>{const plan=JSON.parse(await fs.readFile(options.env.ROMDEX_UPDATE_PLAN,'utf8'));assert.equal(await fs.readFile(path.join(plan.backup,'service/pending.json'),'utf8'),'durable-work');await fs.writeFile(path.join(fixture.directory,'install-status.json'),JSON.stringify({nonce:plan.nonce,phase:'waiting'}));},10);return child;}});assert.deepEqual(order,['checkpoint','quiesce','launch']);assert.equal(result.plan.toVersion,'0.5.4');await result.abort();assert.equal(await fs.readFile(path.join(fixture.directory,'install-aborted.flag'),'utf8'),result.plan.nonce);});
test('checkpoint or helper preflight failure resumes current work and never approves quitting',async t=>{const fixture=await handoffFixture(t);let resumed=0,launched=0;await assert.rejects(createHandoff({...fixture,checkpoint:async()=>{throw Error('Finish the Open Form');},resume:async()=>resumed++,launch:()=>launched++}),/Open Form/);assert.equal(resumed,1);assert.equal(launched,0);await assert.rejects(createHandoff({...fixture,resume:async()=>resumed++,launch:(_exe,_args,options)=>{const child=new EventEmitter();child.unref=()=>{};setTimeout(async()=>{const plan=JSON.parse(await fs.readFile(options.env.ROMDEX_UPDATE_PLAN,'utf8'));await fs.writeFile(path.join(fixture.directory,'install-status.json'),JSON.stringify({nonce:plan.nonce,phase:'failed',message:'Product Identity Mismatch'}));},10);return child;}}),/Identity Mismatch/);assert.equal(resumed,2);});
