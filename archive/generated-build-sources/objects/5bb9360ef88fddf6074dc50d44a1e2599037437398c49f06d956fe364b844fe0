import fs from 'node:fs/promises';import path from 'node:path';
import {ContentCache} from './cache.mjs';import {ContentReader} from './reader.mjs';import {ContentEditor} from './writer.mjs';import {YouTrackContentReader} from './youtrack-reader.mjs';import {YouTrackContentWriter} from './youtrack-writer.mjs';import {acceptedMigration,CONTENT_WORKSPACE} from './authorization.mjs';import {requireThat,same,isHash} from './contracts.mjs';
export async function openContentProvider({profile,protect,enabled,changed}){
 const base=path.dirname(profile),file=path.join(base,'cloud/content-provider.json');let config;try{config=JSON.parse(await fs.readFile(file,'utf8'));}catch(e){if(e.code==='ENOENT')return null;throw e;}
 requireThat(config.format==='ROMDexContentProvider/1'&&config.state==='active'&&config.workspace===CONTENT_WORKSPACE&&/^\d+-\d+$/.test(config.registryIssueId)&&isHash(config.bootstrapPublication)&&config.sourceSHA256===config.acceptance?.sourceSHA256,'The Content Provider Handoff Needs Review.');acceptedMigration(config.acceptance);
 const cache=new ContentCache({directory:path.join(base,'cloud/content'),workspace:CONTENT_WORKSPACE,authorization:config.acceptance});
 try{const pin=cache.get('handoff');requireThat(pin&&same(pin,config),'The Content Provider and Verified Cache Disagree.');const credential=async()=>protect(await fs.readFile(path.join(profile,'connection.encrypted'),'utf8'),true),transport=new YouTrackContentReader({projectId:'0-2',registryIssueId:config.registryIssueId,ownerId:'2-2',privateIssues:true,credential});
  const reader=new ContentReader({transport,cache,workspace:CONTENT_WORKSPACE,bootstrapPublication:config.bootstrapPublication,authorization:config.acceptance,enabled:()=>false}),editor=new ContentEditor({reader,transport:new YouTrackContentWriter({registryIssueId:config.registryIssueId,workspace:CONTENT_WORKSPACE,marker:'ROMDexNPCDexContent/1\nWorkspace: '+CONTENT_WORKSPACE,authorization:config.acceptance,credential}),enabled,changed:()=>changed(provider.view())});
  requireThat(reader.view().active,'No Verified Content Handoff Snapshot Is Available.');
  const provider={kind:'youtrack-content',reader,editor,cache,journal:cache,local:Promise.resolve(),view(gender){const view=editor.view(gender);return {...view,provider:'youtrack-content',status:{...view.status,label:'NPCDex',cloud:true,pending:view.status.pendingWrites,review:view.review.length>0,localCheckpoint:true}};},stage(){throw Error('Use the Versioned Content Editor; Whole-Save Writes Are Disabled After Content Migration.');},async cycle(manual=false){await editor.sync(manual);return this.view().status;},start:()=>editor.start(),stop:()=>editor.stop(),async api(route,input){
   requireThat(typeof route==='string'&&JSON.stringify(input??null).length<=1024*1024,'Invalid Content Request.');
   if(route.startsWith('/api/view'))return this.view(new URL(route,'https://local.invalid').searchParams.get('gender')||'male');
   if(route==='/api/editor'){const work=editor.working(),conflict=reader.view().review.find(r=>r.kind==='competing-publications');return {head:work.head,review:reader.view().review,records:work.domain?.records||[],plans:work.domain?.plans||[],reviews:work.domain?.reviews||[],draft:cache.get('editor-draft'),operations:editor.operations().filter(o=>!['committed','cancelled'].includes(o.state)).map(o=>({id:o.id,description:o.description,state:o.state,error:o.error,artifacts:o.artifacts,uncertainSlots:Object.entries(o.slots).filter(([,s])=>s.state==='sending').map(([key,s])=>({key,kind:s.kind}))})),conflicts:conflict?.heads.map(head=>({head,records:cache.get('domain:'+head).records}))||[]};}
   if(route==='/api/draft'){requireThat(input&&Number.isSafeInteger(input.version)&&input.version>=1&&Object.keys(input).every(k=>['version','draft'].includes(k))&&(input.draft===null||input.draft&&typeof input.draft==='object'),'Invalid Editor Draft.');const prior=cache.get('editor-draft');requireThat(!prior||input.version>prior.version||same(input,prior),'A Newer Editor Draft Exists. Keep This Form Open and Review It.');cache.set('editor-draft',input);return input;}
   if(route==='/api/edit'){requireThat(input&&Object.keys(input).every(k=>['command','expectedHead'].includes(k)),'Unsupported Edit Fields.');const result=editor.queue(input.command,input.expectedHead);if(enabled())queueMicrotask(()=>editor.sync());return result;}
   if(route==='/api/sync'){await editor.sync(true);return this.view();}
   if(route==='/api/recover'){if(input?.action==='resolve'){const result=editor.queueResolution(input.heads,input.choices);if(enabled())queueMicrotask(()=>editor.sync());return result;}if(input?.action==='retry')return editor.retryUncertain(input.id,input.key);if(input?.action==='cancel')return editor.cancel(input.id);}
   throw Error('Unsupported Content Command.');
  }};return provider;
 }catch(e){cache.close();throw e;}
}
